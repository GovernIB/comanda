root = true

[*]
indent_style = space
indent_size = 4
tab_width = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.java]
max_line_length = 120
ij_any_max_line_length = 120

[*.{properties}]
indent_size = 4

[*.{xml,xsd,wsdl}]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{js,ts,jsx,tsx,json}]
indent_size = 4

[*.sql]
indent_size = 4

[*.md]
indent_size = 4
trim_trailing_whitespace = false
